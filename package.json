{
  "name": "timelink-player",
  "version": "1.1.8",
  "description": "TimeLink TL3 V5 보호 파일 확인 및 서버 인증 온라인 재생",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "node scripts/run-tests.cjs"
  },
  "build": {
    "appId": "digital.timelink.player",
    "productName": "TimeLink Player",
    "fileAssociations": [
      {
        "ext": "tl3",
        "name": "TimeLink Music",
        "description": "TL 음악 파일",
        "mimeType": "application/x-timelink-music"
      },
      {
        "ext": "tl4",
        "name": "TimeLink Video",
        "description": "TL 영상 파일",
        "mimeType": "application/x-timelink-video"
      },
      {
        "ext": "tlg",
        "name": "TimeLink Image",
        "description": "TL 이미지 파일",
        "mimeType": "application/x-timelink-image"
      },
      {
        "ext": "tld",
        "name": "TimeLink Document",
        "description": "TL 문서 파일",
        "mimeType": "application/x-timelink-doc"
      },
      {
        "ext": "tle",
        "name": "TimeLink File",
        "description": "TL 파일",
        "mimeType": "application/x-timelink"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "TimeLink-Player-Setup-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "TimeLink-Player-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "TimeLink-Player-${version}.${ext}",
      "maintainer": "TimeLink <creator@timelink.digital>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TimeLink Player",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "author": {
    "name": "TILO Group",
    "email": "creator@timelink.digital"
  }
}
